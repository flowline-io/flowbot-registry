# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Go
*.go text eol=lf

# Templ
*.templ text eol=lf

# Documentation
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Config
.env text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# License
LICENSE text eol=lf

# Shell
*.sh text eol=lf

# CI
*.yml text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.pem binary
